# nginx 反代示例：把 codex.example.com 的请求转给本机 8790 的 Codex Web
#
# 要点：
#   1. proxy_buffering off —— SSE 必须关闭缓冲，否则浏览器看不到实时输出；
#   2. proxy_read_timeout 要足够长（任务可能跑很久），否则长任务会被断开；
#   3. 后端只监听 127.0.0.1，不要直接对外暴露 8790。
#
# 证书申请（certbot）：sudo certbot --nginx -d codex.example.com

server {
    listen 80;
    server_name codex.example.com;

    # 用 webroot 方式申请证书时保留 ACME 校验路径
    location /.well-known/acme-challenge/ {
        root /var/www/codex-web;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name codex.example.com;

    ssl_certificate     /etc/nginx/ssl/codex.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/codex.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;

    client_max_body_size 32m;

    # 可选的第二道门：只允许自己的出口 IP
    # allow 203.0.113.10;
    # deny all;

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
